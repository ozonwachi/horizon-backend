# --- Supabase ---
# Supabase dashboard > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Not read by the backend, but kept here for reference - this is the key that
# goes into the Flutter app's config, never this one (service role).
SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The uuid of a dedicated Supabase Auth user that holds money an admin
# force-cancels away from both the buyer and seller (see adminForceCancelDeal
# in escrowService.js). Only needed once you actually use that "admin_wallet"
# option - everything else works without this being set. Create the user via
# Supabase dashboard > Authentication > Users > Add user, then insert matching
# rows into public.profiles and public.wallets for it - see the seed note at
# the bottom of project_supabase_schema.sql for the exact SQL.
ADMIN_WALLET_UID=paste-that-user's-uuid-here

# --- Paystack ---
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx

# --- Server ---
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000
